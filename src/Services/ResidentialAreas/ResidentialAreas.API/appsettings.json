{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=residentialareadb;Port=5432;Database=ResidentialAreasDB;Username=postgres;Password=postgres;"
  },
  "LocationValidator": {
    "BaseUrl": "https://api.countrystatecity.in/v1/",
    "ApiKey": "Api-Key"
  },
  "DefaultImageUrl": "https://example.com/images/area/area-dha-001.jpg",
  "Public_Key": "",
  "Environment": "Development",
  "JwtSettings": {
    "Issuer": "ResidentialComplexManager.Auth",
    "Audience": "ResidentialComplexManager.APIs",
    "PublicKey": ""
  },
  "GrpcSettings": {
    "UserValidationServiceUrl": "https://localhost:7019"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:8080",
        "Protocols": "Http1"
      },
      "Https": {
        "Url": "https://*:8081",
        "Protocols": "Http1"
      }
    }
  }

}
