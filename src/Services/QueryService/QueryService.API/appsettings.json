{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoSettings": {
    "ConnectionString": "mongodb://admin:secret@mongodb:27017/loggerdb?authSource=admin",
    "DatabaseName": "loggerdb",
    "CollectionName": "logs"
  },
  "JwtSettings": {
    "Issuer": "ResidentialComplexManager.Auth",
    "Audience": "ResidentialComplexManager.APIs",
    "PublicKey": ""
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:8080",
        "Protocols": "Http1"
      },
      "Https": {
        "Url": "https://*:8081",
        "Protocols": "Http1"
      }
    }
  },
  "Service": {
    "Name": "QueryService"
  }
}
